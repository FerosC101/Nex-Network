# Copy this file to .env and fill in real values. Restart `npm run dev` after editing.

# Where applicants can reach the Nex team about their application.
VITE_CONTACT_EMAIL=hello@nexnetwork.ph

# The address the community group chat invite will be sent from. Shown on the
# success screen so applicants know what to whitelist / look for in spam.
VITE_SENDER_EMAIL=hello@nexnetwork.ph

# Human-readable review turnaround, shown as copy on the success screen.
VITE_REVIEW_WINDOW=a few days

# Supabase project credentials. See supabase/README.md for setup steps.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: the community group chat link is deliberately NOT here. Anything in a
# VITE_* var is compiled into the public JS bundle and readable by every
# visitor. The invite is emailed by the team only after a registration is
# verified — keep that link in your mail tooling, not in this repo.
